{
    "name": "channel-module",
    "version": "0.0.3",
    "description": "Using syntax close to native modules to invoke code across different JavaScript runtime environments. 使用接近原生模块的写法，在不同的 JavaScript 运行环境之间进行代码调用。",
    "keywords": [
        "channel",
        "module",
        "eval",
        "proxy"
    ],
    "homepage": "https://github.com/memo-cn/channel-module#readme",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.cjs",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "rimraf ./dist/* && rollup -c --configPlugin rollup-plugin-typescript2",
        "format": "prettier --write .",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "dependencies": {
        "object-encoder": "^1.0.2"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@json-serialization/binary": "1.0.4",
        "@json-serialization/error": "1.0.2",
        "@json-serialization/function": "1.0.2",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-json": "^6.1.0",
        "@rollup/plugin-node-resolve": "^16.0.2",
        "@rollup/plugin-replace": "^6.0.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@types/node": "^24.6.2",
        "json-serialization": "1.0.3",
        "less": "^4.4.2",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "rollup": "^4.52.4",
        "rollup-plugin-dts": "^6.2.3",
        "rollup-plugin-typescript2": "^0.36.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vite": "7.3.0",
        "vitepress": "^1.6.4",
        "vue": "^3.5.22"
    },
    "files": [
        "dist",
        "CHANGELOG.md",
        "LICENSE",
        "package.json",
        "README.md",
        "README.zh-CN.md"
    ],
    "author": {
        "name": "memo",
        "email": "i@memo.cool"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:memo-cn/channel-module.git"
    },
    "bugs": {
        "email": "i@memo.cool",
        "url": "https://github.com/memo-cn/channel-module/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT"
}
